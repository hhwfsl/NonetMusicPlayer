{
  "schemaVersion": 1,
  "title": "音乐猫桌宠",
  "description": "使用桌宠或此页中的按钮控制播放器。关闭浮窗不影响音乐播放。",
  "widgets": [
    {
      "type": "pet", "title": "音乐猫", "name": "${config.petName}", "text": "准备聆听音乐。",
      "body": "${config.bodyColor}", "accent": "#F19BAC", "floating": "${config.floating}",
      "actions": [
        {"label": "Common.Previous", "action": {"kind": "previous"}},
        {"label": "Playback.PlayPause", "action": {"kind": "play-pause"}},
        {"label": "Common.Next", "action": {"kind": "next"}},
        {"label": "Common.Like", "action": {"kind": "favorite"}},
        {"label": "搜索 music", "action": {"kind": "search", "value": "music"}},
        {"label": "Home.Music", "action": {"kind": "navigate", "value": "library"}}
      ]
    },
    {"type": "listening-summary", "title": "听歌统计"}
  ],
  "flows": [
    {"event": "track-changed", "action": {"kind": "show-message", "value": "正在播放：{title} · {artist}"}},
    {"event": "interval", "intervalSeconds": 120, "action": {"kind": "show-message", "value": "当前歌曲：{title}"}}
  ]
}
