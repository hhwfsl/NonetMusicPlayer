{
  "id": "sample.http-provider",
  "name": "HTTP 音源适配器示例",
  "version": "1.0.0",
  "contractVersion": 1,
  "type": "provider",
  "author": "NonetMusicPlayer",
  "description": "开发示例：适配自定义曲库 JSON 与音频接口。不是服务器软件，也不会搭建服务器。可使用 fixtureFolder 验证本地 Contract。",
  "permissions": ["network", "process", "filesystem"],
  "lifecycleMethods": ["lifecycle.disable", "lifecycle.uninstall", "lifecycle.shutdown"],
  "entryPoints": {
    "win-x64": "SampleProvider.exe",
    "osx-x64": "SampleProvider",
    "linux-x64": "SampleProvider"
  }
}
