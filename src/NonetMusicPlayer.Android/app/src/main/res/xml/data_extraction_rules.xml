<?xml version="1.0" encoding="utf-8"?>
<!-- 令牌依赖本机 Keystore，禁止把无法解密的私有数据迁移到其他设备。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/><exclude domain="file" path="."/>
        <exclude domain="database" path="."/><exclude domain="sharedpref" path="."/><exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/><exclude domain="file" path="."/>
        <exclude domain="database" path="."/><exclude domain="sharedpref" path="."/><exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
